rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼ 최고 관리자 이메일 — firebase-config.js 의 ADMIN_EMAILS 와 같게 유지
    function adminEmails() {
      return ['2min095156@gmail.com'];
    }

    function signedIn() { return request.auth != null; }
    function isAdminEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in adminEmails();
    }
    function hasAcct() {
      return signedIn() && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }
    function acct() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
    }
    function isAdmin() { return isAdminEmail() || (hasAcct() && acct().role == 'admin'); }
    function isStaff() { return isAdmin() || (hasAcct() && acct().role in ['teacher', 'sync']); }
    function isStudent(no) { return hasAcct() && acct().role == 'student' && acct().key == no; }
    function isStaffSelf(id) { return hasAcct() && acct().role in ['teacher', 'admin'] && acct().key == id; }
    // 본인이 바꿀 수 있는 필드: 비밀번호 변경 표시만
    function onlyPwFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['mustChangePw', 'initialPw', 'pwChangedAt']);
    }
    // 학생이 자기 예상질문을 넣고·고치고·지울 때 함께 바꾸는 개수 3개만 (0 이상 정수, 대기 ≤ 학생 작성 ≤ 전체)
    function onlyPqCountFields() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['pqCount', 'pqMine', 'pqPending'])
        && d.get('pqCount', 0) is int && d.get('pqMine', 0) is int && d.get('pqPending', 0) is int
        && d.get('pqPending', 0) >= 0 && d.get('pqPending', 0) <= d.get('pqMine', 0)
        && d.get('pqMine', 0) <= d.get('pqCount', 0);
    }
    // 학생이 쓰는 예상질문 글: 질문·생기부 근거는 빈칸 안 됨, 꼬리질문은 목록(10개까지)
    function pqTextOk(d) {
      return d.text is string && d.text.trim().size() > 0 && d.text.size() <= 300
        && d.basis is string && d.basis.trim().size() > 0 && d.basis.size() <= 200
        && (!('followUps' in d) || (d.followUps is list && d.followUps.size() <= 10));
    }

    // uid → 역할(admin/teacher/student/sync)과 키(staffId/학번). 관리자만 쓰기
    // sync = 구글 시트 Apps Script 가 쓰는 동기화 전용 계정 (교사 화면에는 로그인 불가)
    match /accounts/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow write: if isAdmin();
    }

    // 로그인 ID → 이메일 (재발급 시 바뀜). 로그인 전에 읽어야 해서 공개, 이메일 외 정보 없음
    match /logins/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 지도교사
    match /staff/{sid} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isStaffSelf(sid) && onlyPwFields());
    }

    // 학생 (문서 ID = 학번)
    match /students/{no} {
      allow read: if isStaff() || isStudent(no);
      allow create, delete: if isStaff();
      allow update: if isStaff() || (isStudent(no) && (onlyPwFields() || onlyPqCountFields()));

      // 예상질문: 교사는 전부. 학생은 자기 학번 아래 by:"student" 로만 만들고,
      // 자기가 만든 것 중 검토 전(reviewedAt 없음)만 고치기·지우기. 검토 칸(by·reviewedAt·reviewedBy·editedByTeacher·origText)은 못 씀
      match /personalQuestions/{qid} {
        allow read: if isStaff() || isStudent(no);
        allow write: if isStaff();
        allow create: if isStudent(no) && request.resource.data.by == 'student'
          && request.resource.data.keys().hasAll(['text', 'basis', 'by', 'createdAt'])
          && request.resource.data.keys().hasOnly(['text', 'basis', 'followUps', 'category', 'type', 'by', 'addedBy', 'source', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && pqTextOk(request.resource.data);
        allow update: if isStudent(no) && resource.data.get('by', '') == 'student' && resource.data.get('reviewedAt', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'basis', 'followUps'])
          && pqTextOk(request.resource.data);
        allow delete: if isStudent(no) && resource.data.get('by', '') == 'student' && resource.data.get('reviewedAt', null) == null;
      }
    }

    // 대학별 면접일 (시트 '앱연동_면접일'과 쌍방 동기화). 학생은 자기 것만 읽기
    match /interviews/{iid} {
      allow read: if isStaff() || isStudent(resource.data.studentNo);
      allow write: if isStaff();
    }

    // 실제 대학 면접 후기 (문서 id = 면접일 문서 id). 선생님 전체 · 학생은 자기 것만
    function reviewFields() {
      return ['studentNo', 'name', 'cls', 'interviewId', 'univ', 'dept', 'admission', 'format',
              'date', 'year', 'questions', 'helped', 'regret', 'mood', 'difficulty',
              'createdAtMs', 'updatedAtMs'];
    }
    function reviewShapeOk() {
      let d = request.resource.data;
      return d.keys().hasAll(['studentNo', 'date', 'updatedAtMs'])
        && d.keys().hasOnly(reviewFields())
        && d.studentNo is string
        && d.get('mood', 0) is int && d.get('mood', 0) >= 0 && d.get('mood', 0) <= 5
        && d.get('difficulty', 0) is int && d.get('difficulty', 0) >= 0 && d.get('difficulty', 0) <= 5
        && d.get('questions', '').size() <= 4000
        && d.get('helped', '').size() <= 2000
        && d.get('regret', '').size() <= 2000;
    }
    match /reviews/{rid} {
      allow read: if isStaff() || isStudent(resource.data.studentNo);
      allow create: if reviewShapeOk()
        && (isStaff() || isStudent(request.resource.data.studentNo));
      // 남의 후기로 바꿔치기 금지: 학번은 절대 바뀌지 않는다
      allow update: if reviewShapeOk()
        && request.resource.data.studentNo == resource.data.studentNo
        && (isStaff() || isStudent(resource.data.studentNo));
      allow delete: if isStaff();
    }

    // 교사 전용 메모 등 (학생 접근 불가)
    match /studentNotes/{no} {
      allow read, write: if isStaff();
    }

    // 공용 질문은행
    match /questions/{qid} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // 학생 스스로 하는 모의면접 연습
    match /sessions/{sid} {
      allow read: if isStaff()
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if isStaff()
        || (signedIn()
            && request.resource.data.studentUid == request.auth.uid
            && isStudent(request.resource.data.studentNo)
            && request.resource.data.status == 'in_progress'
            && !request.resource.data.keys().hasAny(['teacherFeedback', 'aiFeedback', 'reviewedAt']));
      allow update: if isStaff()
        || (signedIn()
            && resource.data.studentUid == request.auth.uid
            && request.resource.data.studentUid == request.auth.uid
            && request.resource.data.studentNo == resource.data.studentNo
            && resource.data.status == 'in_progress'
            && request.resource.data.status in ['in_progress', 'submitted']
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['teacherFeedback', 'aiFeedback', 'reviewedAt']))
        // 면접 부스 AI 피드백: 부스 기록(mode booth)의 aiReport 칸 하나만, 본인 토큰으로 (제출 뒤에도 — Apps Script 가 학생 토큰으로 씀)
        || (signedIn()
            && resource.data.studentUid == request.auth.uid
            && resource.data.mode == 'booth'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiReport']));
      allow delete: if isStaff();
    }

    // 대면 모의면접 기록 (교사 작성). 학생은 '공개'된 자기 기록만 읽기
    match /meetings/{mid} {
      allow read: if isStaff()
        || (signedIn() && resource.data.studentUid == request.auth.uid && resource.data.shared == true);
      allow write: if isStaff();
    }

    // 시트 동기화 설정 등. 'schedule'(시간표·장소·동기화 주소)은 학생도 읽기
    match /config/{docId} {
      // push: 웹 푸시 공개 키 (원래 공개되는 값 · 학생도 읽어야 알림을 켤 수 있음)
      allow read: if isStaff() || (docId in ['schedule', 'push'] && hasAcct());
      allow write: if isAdmin();
    }
    // 면접 부스: 등록된 부스 PC 목록 (항목 이름은 PC 키의 SHA-256 해시 — 키 자체는 없음)
    // 학생이 부스에서 로그인한 뒤 '이 PC 가 아직 등록돼 있는지' 확인하려고 읽는다. 쓰기는 관리자만
    // (위 config/{docId} 규칙은 그대로 — 이 블록은 계정 있는 사용자 읽기만 더한다)
    match /config/booth {
      allow read: if hasAcct();
      allow write: if isAdmin();
    }

    // 휴대폰 알림을 받을 기기 목록. 본인 것만 넣고 뺄 수 있고, 보내는 쪽(교사·동기화)만 전체를 읽는다
    match /pushTokens/{token} {
      allow read: if isStaff();
      allow create, update: if hasAcct()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'role', 'key', 'name', 'createdAtMs', 'lastSeenMs'])
        && request.resource.data.role in ['student', 'staff']
        && request.resource.data.key == string(acct().get('key', ''));
      // 본인 기기이거나, 보내다가 '없는 기기' 로 확인된 것을 동기화 계정이 정리
      allow delete: if isStaff() || (resource != null && resource.data.uid == request.auth.uid);
    }

    // 보낼 알림 대기열. 교사만 적고, 보낸 표시는 동기화 계정이 한다. 아무도 읽을 필요가 없다
    match /notify/{nid} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['role', 'key', 'title', 'body', 'url', 'tag', 'createdAtMs', 'sentAtMs'])
        && request.resource.data.sentAtMs == 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.get('body', '').size() <= 140;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sentAtMs']);
      allow delete: if isStaff();
    }

    // 목록별 '바뀐 시각' 표시 (브라우저 캐시를 쓸지 판단 · 읽기 줄이기). 교사·동기화 계정이 바꿀 때 기록
    match /meta/{docId} {
      allow read: if hasAcct() || isAdmin();
      allow write: if isStaff();
      // 학생: 예상질문·비밀번호를 바꿀 때 학생 목록 '바뀜' 표시(students 칸 하나)만, 서버 시각으로만
      allow update: if docId == 'versions' && hasAcct() && acct().role == 'student'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
        && request.resource.data.students == request.time;
    }

    // 백업(시트 Apps Script)용: 모든 학생의 예상질문을 한 번에 읽기 — 교사·동기화 계정만
    match /{path=**}/personalQuestions/{qid} {
      allow read: if isStaff();
    }

    // ================= 모의면접 일정 =================
    function isStudentAcct() { return hasAcct() && acct().role == 'student'; }

    // 교사별 불가 시간 (요일별 수업 교시·날짜별 예외). 모두 읽기, 본인·관리자만 쓰기
    match /availability/{sid} {
      allow read: if hasAcct() || isAdmin();
      allow write: if isAdmin() || isStaffSelf(sid);
    }

    // 날짜별 일정 요약 (달력). 로그인한 사람 모두 읽기 — 교사·장소 겹침을 서로 보고 피하도록
    // 학생은 자기 일정 한 건(lastId)만 넣거나 뺄 수 있다
    function dayItemsBefore() { return resource == null ? {} : resource.data.get('items', {}); }
    function bkPath(id) { return /databases/$(database)/documents/bookings/$(id); }
    // 같은 트랜잭션에서 저장되는 예약 문서(getAfter)와 요약이 실제로 일치하는지 확인한다.
    // 학생이 요약만 따로 고쳐 남의 일정을 지우거나 시간·상태를 위조하지 못하게 한다.
    function dayItemMatchesBooking(date, id, it) {
      return existsAfter(bkPath(id)) && dayItemEq(date, id, it);
    }
    function dayItemEq(date, id, it) {
      let b = getAfter(bkPath(id)).data;
      return b.studentNo == acct().key
        && it.no == acct().key
        && b.date == date
        && it.status == b.status
        && it.stage == b.stage
        && it.block == b.block
        && it.start == b.start
        && it.end == b.end
        && it.room == b.get('room', '')
        && it.teachers == b.teachers;
    }
    // 요약에서 뺄 때: 원래 내 일정이어야 하고, 예약 문서가 남아 있다면 그것도 내 것이어야 한다
    function dayItemRemoveOk(id, before) {
      return id in before && before[id].no == acct().key
        && (!existsAfter(bkPath(id)) || getAfter(bkPath(id)).data.studentNo == acct().key);
    }
    function studentDayWrite(date) {
      let id = request.resource.data.lastId;
      let after = request.resource.data.get('items', {});
      let before = dayItemsBefore();
      return isStudentAcct()
        && request.resource.data.keys().hasOnly(['items', 'lastId', 'updatedAtMs'])
        && after.diff(before).affectedKeys().hasOnly([id])
        && (!(id in before) || before[id].no == acct().key)
        && (id in after ? dayItemMatchesBooking(date, id, after[id]) : dayItemRemoveOk(id, before));
    }
    match /days/{date} {
      allow read: if hasAcct() || isAdmin();
      allow create, update: if isStaff() || studentDayWrite(date);
      allow delete: if isAdmin();
    }

    // 일정 신청 (학생 1명 + 배정 교사). 학생은 자기 배정 교사에게만 신청, 교사 수락을 대신할 수 없음
    function assignOf(no) { return get(/databases/$(database)/documents/students/$(no)).data.get('assign', {}); }
    function teachersMatchAssign(d) {
      let a = assignOf(d.studentNo);
      return (d.stage == 1 && d.teachers.size() == 1 && d.teachers.hasOnly([a.get('s1', '')]))
        || (d.stage == 2 && d.teachers.size() == 1 && d.teachers.hasOnly([a.get('s2', '')]))
        || (d.stage == 3 && d.teachers.size() >= 1 && d.teachers.hasOnly([a.get('s3a', ''), a.get('s3b', '')]));
    }
    function confirmedOk(d) { return d.status != 'confirmed' || d.approvedBy.toSet().hasAll(d.need); }
    match /bookings/{bid} {
      allow read: if isStaff() || isStudent(resource.data.studentNo);
      allow create: if isStaff()
        || (isStudent(request.resource.data.studentNo)
            && teachersMatchAssign(request.resource.data)
            && request.resource.data.need.toSet() == request.resource.data.teachers.toSet().union(['student'].toSet())
            && request.resource.data.approvedBy == ['student']
            && request.resource.data.status == 'requested');
      allow update: if isStaff()
        || (isStudent(resource.data.studentNo)
            && resource.data.status in ['requested', 'confirmed']
            && request.resource.data.status in ['requested', 'confirmed', 'cancelled', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['approvedBy', 'status', 'date', 'block', 'start', 'end', 'room', 'memo', 'proposedBy', 'updatedAtMs', 'updatedBy', 'done', 'doneAtMs'])
            // 학생은 '완료'를 세울 수 없다. 시간을 옮겨 다시 잡을 때 푸는 것만 가능
            && request.resource.data.get('done', false) == false
            // 학생이 교사 수락을 추가할 수는 없음
            && request.resource.data.approvedBy.toSet().difference(resource.data.approvedBy.toSet()).hasOnly(['student'])
            // 시간·장소를 바꾸면 교사 수락은 모두 초기화
            && ((request.resource.data.date == resource.data.date && request.resource.data.start == resource.data.start
                 && request.resource.data.end == resource.data.end && request.resource.data.room == resource.data.room)
                || request.resource.data.approvedBy == ['student'])
            && confirmedOk(request.resource.data));
      allow delete: if isAdmin();
    }

    // ===== 면접 부스·셀프 연습 예약 (booth-booking.js) =====
    // 선착순 바로 확정. 칸 문서(boothSlots)는 그 칸을 잡은 예약 id 만 담는다(학번·이름 없음 → 학생은 'n/정원'만 앎).
    // 학생은 자기 예약 하나를 칸 문서와 함께 한 번에 넣고·빼며, 정원은 config/schedule.boothCaps(없으면 아래 기본값).
    // 막힌 칸(closed)·매주 막는 시간·날짜 범위·이어진 칸 2개 한도는 화면에서 막고, 교사는 언제든 지울 수 있다.
    function boothCaps() {
      let p = /databases/$(database)/documents/config/schedule;
      return exists(p) ? get(p).data.get('boothCaps', {'booth1': 1, 'booth2': 1, 'self': 4}) : {'booth1': 1, 'booth2': 1, 'self': 4};
    }
    function bbPath(id) { return /databases/$(database)/documents/boothBookings/$(id); }
    function bsPath(id) { return /databases/$(database)/documents/boothSlots/$(id); }
    // 예약이 가리키는 칸 문서가 이 예약 id 를 담고 같은 날짜·자리인지
    function bbSlotOk(sid, bid, d) {
      let s = getAfter(bsPath(sid)).data;
      return s.ids.hasAny([bid]) && s.date == d.date && s.res == d.res;
    }
    match /boothBookings/{bid} {
      allow read: if isStaff() || isStudent(resource.data.studentNo);
      allow create: if isStaff()
        || (isStudent(request.resource.data.studentNo)
            && request.resource.data.keys().hasOnly(['studentNo', 'studentName', 'res', 'date', 'start', 'end', 'slots', 'createdBy', 'createdAt'])
            && request.resource.data.createdBy == 'student'
            && request.resource.data.createdAt == request.time
            && request.resource.data.res in boothCaps()
            && request.resource.data.slots is list
            && request.resource.data.slots.size() >= 1 && request.resource.data.slots.size() <= 2
            && bbSlotOk(request.resource.data.slots[0], bid, request.resource.data)
            && (request.resource.data.slots.size() == 1 || bbSlotOk(request.resource.data.slots[1], bid, request.resource.data)));
      allow update: if isStaff();
      // 학생 취소: 칸 문서에서도 함께 빠져야 함
      allow delete: if isStaff()
        || (isStudent(resource.data.studentNo)
            && !getAfter(bsPath(resource.data.slots[0])).data.ids.hasAny([bid])
            && (resource.data.slots.size() == 1 || !getAfter(bsPath(resource.data.slots[1])).data.ids.hasAny([bid])));
    }
    // 학생이 칸 문서에 넣거나 뺄 때: last = 이번에 넣거나 뺀 예약 id (그 예약 문서가 내 것이어야 함)
    function bsAddOk(sid, last) {
      let b = getAfter(bbPath(last)).data;
      return b.studentNo == acct().key && b.slots.hasAny([sid]);
    }
    function bsRemoveOk(last) {
      return !existsAfter(bbPath(last)) && get(bbPath(last)).data.studentNo == acct().key;
    }
    match /boothSlots/{sid} {
      allow read: if hasAcct() || isAdmin();
      allow delete: if isStaff();
      allow create: if isStaff()
        || (hasAcct() && acct().role == 'student'
            && request.resource.data.keys().hasOnly(['date', 'res', 'start', 'end', 'ids', 'last'])
            && request.resource.data.res in boothCaps()
            && sid == request.resource.data.date + '_' + request.resource.data.res + '_' + request.resource.data.start.replace(':', '')
            && request.resource.data.ids == [request.resource.data.last]
            && bsAddOk(sid, request.resource.data.last));
      allow update: if isStaff()
        || (hasAcct() && acct().role == 'student'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ids', 'last'])
            && (
              // 넣기: 막히지 않은 칸 · 정원 안 · 내 예약 하나만 더함
              (resource.data.get('closed', false) == false
                && !resource.data.ids.hasAny([request.resource.data.last])
                && request.resource.data.ids.size() == resource.data.ids.size() + 1
                && request.resource.data.ids.toSet() == resource.data.ids.toSet().union([request.resource.data.last].toSet())
                && request.resource.data.ids.size() <= boothCaps()[resource.data.res]
                && bsAddOk(sid, request.resource.data.last))
              // 빼기: 내 예약 하나만 뺌 (예약 문서도 함께 지워짐)
              || (resource.data.ids.hasAny([request.resource.data.last])
                && request.resource.data.ids.size() == resource.data.ids.size() - 1
                && request.resource.data.ids.toSet() == resource.data.ids.toSet().difference([request.resource.data.last].toSet())
                && bsRemoveOk(request.resource.data.last))
            ));
    }

    // 일정 변경 로그 (시트 '면접 기록' 탭으로 옮겨짐). 추가만 가능
    match /bookingLogs/{lid} {
      allow read: if isStaff();
      allow create: if isStaff() || (isStudentAcct() && request.resource.data.studentNo == acct().key);
      allow update, delete: if false;
    }
  }
}
