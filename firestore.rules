rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼ 최고 관리자 이메일 — firebase-config.js 의 ADMIN_EMAILS 와 같게 유지
    function adminEmails() {
      return ['2min095156@gmail.com'];
    }

    function signedIn() { return request.auth != null; }
    function isAdminEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in adminEmails();
    }
    function hasAcct() {
      return signedIn() && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }
    function acct() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
    }
    function isAdmin() { return isAdminEmail() || (hasAcct() && acct().role == 'admin'); }
    function isStaff() { return isAdmin() || (hasAcct() && acct().role in ['teacher', 'sync']); }
    function isStudent(no) { return hasAcct() && acct().role == 'student' && acct().key == no; }
    function isStaffSelf(id) { return hasAcct() && acct().role in ['teacher', 'admin'] && acct().key == id; }
    // 본인이 바꿀 수 있는 필드: 비밀번호 변경 표시만
    function onlyPwFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['mustChangePw', 'initialPw', 'pwChangedAt']);
    }

    // uid → 역할(admin/teacher/student/sync)과 키(staffId/학번). 관리자만 쓰기
    // sync = 구글 시트 Apps Script 가 쓰는 동기화 전용 계정 (교사 화면에는 로그인 불가)
    match /accounts/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow write: if isAdmin();
    }

    // 로그인 ID → 이메일 (재발급 시 바뀜). 로그인 전에 읽어야 해서 공개, 이메일 외 정보 없음
    match /logins/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 지도교사
    match /staff/{sid} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isStaffSelf(sid) && onlyPwFields());
    }

    // 학생 (문서 ID = 학번)
    match /students/{no} {
      allow read: if isStaff() || isStudent(no);
      allow create, delete: if isStaff();
      allow update: if isStaff() || (isStudent(no) && onlyPwFields());

      match /personalQuestions/{qid} {
        allow read: if isStaff() || isStudent(no);
        allow write: if isStaff();
      }
    }

    // 대학별 면접일 (시트 '앱연동_면접일'과 쌍방 동기화). 학생은 자기 것만 읽기
    match /interviews/{iid} {
      allow read: if isStaff() || isStudent(resource.data.studentNo);
      allow write: if isStaff();
    }

    // 교사 전용 메모 등 (학생 접근 불가)
    match /studentNotes/{no} {
      allow read, write: if isStaff();
    }

    // 공용 질문은행
    match /questions/{qid} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // 학생 스스로 하는 모의면접 연습
    match /sessions/{sid} {
      allow read: if isStaff()
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if isStaff()
        || (signedIn()
            && request.resource.data.studentUid == request.auth.uid
            && isStudent(request.resource.data.studentNo)
            && request.resource.data.status == 'in_progress'
            && !request.resource.data.keys().hasAny(['teacherFeedback', 'aiFeedback', 'reviewedAt']));
      allow update: if isStaff()
        || (signedIn()
            && resource.data.studentUid == request.auth.uid
            && request.resource.data.studentUid == request.auth.uid
            && request.resource.data.studentNo == resource.data.studentNo
            && resource.data.status == 'in_progress'
            && request.resource.data.status in ['in_progress', 'submitted']
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['teacherFeedback', 'aiFeedback', 'reviewedAt']));
      allow delete: if isStaff();
    }

    // 대면 모의면접 기록 (교사 작성). 학생은 '공개'된 자기 기록만 읽기
    match /meetings/{mid} {
      allow read: if isStaff()
        || (signedIn() && resource.data.studentUid == request.auth.uid && resource.data.shared == true);
      allow write: if isStaff();
    }

    // 시트 동기화 설정 등. 'schedule'(시간표·장소·동기화 주소)은 학생도 읽기
    match /config/{docId} {
      allow read: if isStaff() || (docId == 'schedule' && hasAcct());
      allow write: if isAdmin();
    }

    // ================= 모의면접 일정 =================
    function isStudentAcct() { return hasAcct() && acct().role == 'student'; }

    // 교사별 불가 시간 (요일별 수업 교시·날짜별 예외). 모두 읽기, 본인·관리자만 쓰기
    match /availability/{sid} {
      allow read: if hasAcct() || isAdmin();
      allow write: if isAdmin() || isStaffSelf(sid);
    }

    // 날짜별 일정 요약 (달력). 로그인한 사람 모두 읽기 — 교사·장소 겹침을 서로 보고 피하도록
    // 학생은 자기 일정 한 건(lastId)만 넣거나 뺄 수 있다
    function dayItemsBefore() { return resource == null ? {} : resource.data.get('items', {}); }
    function studentDayWrite() {
      let id = request.resource.data.lastId;
      let after = request.resource.data.get('items', {});
      let before = dayItemsBefore();
      return isStudentAcct()
        && request.resource.data.keys().hasOnly(['items', 'lastId', 'updatedAtMs'])
        && after.diff(before).affectedKeys().hasOnly([id])
        && (id in after ? after[id].no == acct().key : (id in before && before[id].no == acct().key));
    }
    match /days/{date} {
      allow read: if hasAcct() || isAdmin();
      allow create, update: if isStaff() || studentDayWrite();
      allow delete: if isAdmin();
    }

    // 일정 신청 (학생 1명 + 배정 교사). 학생은 자기 배정 교사에게만 신청, 교사 수락을 대신할 수 없음
    function assignOf(no) { return get(/databases/$(database)/documents/students/$(no)).data.get('assign', {}); }
    function teachersMatchAssign(d) {
      let a = assignOf(d.studentNo);
      return (d.stage == 1 && d.teachers.size() == 1 && d.teachers.hasOnly([a.get('s1', '')]))
        || (d.stage == 2 && d.teachers.size() == 1 && d.teachers.hasOnly([a.get('s2', '')]))
        || (d.stage == 3 && d.teachers.size() >= 1 && d.teachers.hasOnly([a.get('s3a', ''), a.get('s3b', '')]));
    }
    function confirmedOk(d) { return d.status != 'confirmed' || d.approvedBy.toSet().hasAll(d.need); }
    match /bookings/{bid} {
      allow read: if isStaff() || isStudent(resource.data.studentNo);
      allow create: if isStaff()
        || (isStudent(request.resource.data.studentNo)
            && teachersMatchAssign(request.resource.data)
            && request.resource.data.need.toSet() == request.resource.data.teachers.toSet().union(['student'].toSet())
            && request.resource.data.approvedBy == ['student']
            && request.resource.data.status == 'requested');
      allow update: if isStaff()
        || (isStudent(resource.data.studentNo)
            && resource.data.status in ['requested', 'confirmed']
            && request.resource.data.status in ['requested', 'confirmed', 'cancelled', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['approvedBy', 'status', 'date', 'block', 'start', 'end', 'room', 'memo', 'proposedBy', 'updatedAtMs', 'updatedBy'])
            // 학생이 교사 수락을 추가할 수는 없음
            && request.resource.data.approvedBy.toSet().difference(resource.data.approvedBy.toSet()).hasOnly(['student'])
            // 시간·장소를 바꾸면 교사 수락은 모두 초기화
            && ((request.resource.data.date == resource.data.date && request.resource.data.start == resource.data.start
                 && request.resource.data.end == resource.data.end && request.resource.data.room == resource.data.room)
                || request.resource.data.approvedBy == ['student'])
            && confirmedOk(request.resource.data));
      allow delete: if isAdmin();
    }

    // 일정 변경 로그 (시트 '면접 기록' 탭으로 옮겨짐). 추가만 가능
    match /bookingLogs/{lid} {
      allow read: if isStaff();
      allow create: if isStaff() || (isStudentAcct() && request.resource.data.studentNo == acct().key);
      allow update, delete: if false;
    }
  }
}
